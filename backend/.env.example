# Copy to .env and fill in values

# Option A — Local MongoDB (easiest for development)
# 1. Install Docker Desktop, then run: docker compose up -d
# 2. Use this URI:
MONGO_URI=mongodb://127.0.0.1:27017/servicehub

# Option B — MongoDB Atlas (cloud)
# 1. Go to https://cloud.mongodb.com
# 2. Create or open a cluster (must be Running, not Paused)
# 3. Database Access → create a database user
# 4. Network Access → add your IP (or 0.0.0.0/0 for dev only)
# 5. Connect → Drivers → copy connection string and replace <password>
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/servicehub?retryWrites=true&w=majority

JWT_SECRET=your_secret_key_here
PORT=5000
